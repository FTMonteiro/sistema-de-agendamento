generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String?
  logo    String?

  // Horário de funcionamento. Guardado como "HH:MM" para casar directamente
  // com o input type="time" do formulário, sem conversão de fuso.
  openingTime String?
  closingTime String?

  // Dias da semana em que abre, no formato do getDay() do JavaScript:
  // 0 = domingo ... 6 = sábado.
  workingDays Int[] @default([1, 2, 3, 4, 5, 6])

  // Duração mínima de um intervalo de agendamento, em minutos.
  slotInterval Int @default(30)

  // Regras livres do estabelecimento (política de cancelamento, atrasos...).
  rules String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  clients       Client[]
  professionals Professional[]
  services      Service[]
  users         User[]
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?
  googleId String? @unique

  role UserRole @default(EMPLOYEE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  professional Professional?
}

enum UserRole {
  OWNER
  EMPLOYEE
}

model Professional {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  specialty String?
  avatar    String?
  active    Boolean @default(true)

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String

  userId String? @unique

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  appointments Appointment[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Client {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  businessId String
  active     Boolean  @default(true)

  appointments Appointment[]
  visits       Visit[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  businessId  String

  appointments Appointment[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  businessId     String
  clientId       String
  professionalId String
  serviceId      String

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  payment Payment?
  visit   Visit?
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  appointmentId String @unique

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  visit       Visit?
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MOBILE_MONEY
}

model Visit {
  id String @id @default(cuid())

  clientId      String
  appointmentId String  @unique
  paymentId     String? @unique

  visitedAt DateTime @default(now())
  createdAt DateTime @default(now())

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}
