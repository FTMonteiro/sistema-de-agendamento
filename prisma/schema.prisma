generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id            String         @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  logo          String?
  closingTime   String?
  openingTime   String?
  rules         String?
  slotInterval  Int            @default(30)
  workingDays   Int[]          @default([1, 2, 3, 4, 5, 6])
  appointments  Appointment[]
  clients       Client[]
  notifications Notification[]
  professionals Professional[]
  services      Service[]
  users         User[]
  galleryImages GalleryImage[]
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  password                String?
  role                    UserRole                 @default(EMPLOYEE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  businessId              String
  googleId                String?                  @unique
  emailVerified           Boolean                  @default(false)
  active                  Boolean                  @default(true)
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  paymentReceived         Payment[]                @relation("PaymentReceivedBy")
  professional            Professional?
  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Professional {
  id                       String        @id @default(cuid())
  name                     String
  email                    String?
  phone                    String?
  specialty                String?
  active                   Boolean       @default(true)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  businessId               String
  emailVerificationExpires DateTime?
  emailVerificationToken   String?
  emailVerified            Boolean       @default(false)
  avatar                   String?
  userId                   String?       @unique
  appointments             Appointment[]
  business                 Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                     User?         @relation(fields: [userId], references: [id])
}

model Client {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businessId   String
  active       Boolean       @default(true)
  appointments Appointment[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visits       Visit[]
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  duration     Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businessId   String
  appointments Appointment[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Appointment {
  id             String            @id @default(cuid())
  date           DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  businessId     String
  clientId       String
  professionalId String
  serviceId      String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payment        Payment?
  visit          Visit?
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointmentId String        @unique
  receiptUrl    String?
  receivedById  String?
  reference     String?
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  receivedBy    User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  visit         Visit?
}

model Visit {
  id            String      @id @default(cuid())
  clientId      String
  appointmentId String      @unique
  paymentId     String?     @unique
  visitedAt     DateTime    @default(now())
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payment       Payment?    @relation(fields: [paymentId], references: [id])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id           String           @id @default(cuid())
  title        String
  message      String
  type         NotificationType @default(INFO)
  read         Boolean          @default(false)
  userId       String
  businessId   String
  resourceId   String?
  resourceType String?
  createdAt    DateTime         @default(now())
  readAt       DateTime?
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@index([read])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  EMPLOYEE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MOBILE_MONEY
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model GalleryImage {
  id      String  @id @default(cuid())
  name    String
  url     String
  size    Int
  isCover Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, isCover])
}
